{
  "name": "trading-poc",
  "private": true,
  "version": "0.19.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "trading_poc_001_bollinger"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:paper": "node scripts/local-dev.mjs PAPER",
    "dev:mock": "node scripts/local-dev.mjs MOCK",
    "dev:offline": "node scripts/local-dev.mjs OFFLINE",
    "dev:web": "npm run dev -w @trading-poc/web",
    "dev:api": "npm run dev -w @trading-poc/api",
    "dev:failure-after-start": "node scripts/windows/dev-failure-after-start.mjs",
    "dev:agent": "npm run dev -w @trading-poc/ibkr-agent",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w trading-poc-001-bollinger",
    "test": "vitest run && npm run test -w trading-poc-001-bollinger",
    "build": "npm run build -w @trading-poc/web",
    "test:e2e": "playwright test",
    "academy:import": "tsx apps/api/src/academy/cli.ts",
    "db:generate": "drizzle-kit generate --config apps/api/drizzle.config.ts",
    "ml:train": "node scripts/ml-train.mjs",
    "ml:infer": "node scripts/ml-infer.mjs",
    "ml:observe": "node scripts/ml-observe.mjs",
    "ml:collect": "node scripts/ml-collect.mjs",
    "daily:run": "node --experimental-strip-types scripts/daily-orchestrator.ts",
    "ml:evaluate": "node scripts/ml-evaluate.mjs",
    "ml:replay:prepare": "tsx trading_poc_001_bollinger/src/phase38b-cli.ts",
    "ml:replay:evaluate": "node scripts/ml-replay.mjs",
    "ml:replay:post:prepare": "tsx trading_poc_001_bollinger/src/phase38c-cli.ts",
    "ml:replay:post:evaluate": "node scripts/ml-post-replay.mjs",
    "news:collect": "tsx apps/api/src/news/cli.ts collect",
    "news:analyze": "tsx apps/api/src/news/cli.ts analyze",
    "ml:news-context": "tsx apps/api/src/ml/news-context-cli.ts",
    "alpaca:ingest": "tsx trading_poc_001_bollinger/src/phase32-cli.ts",
    "iex:probe": "tsx trading_poc_001_bollinger/src/phase38-iex-cli.ts --probe",
    "iex:collect": "tsx trading_poc_001_bollinger/src/phase38-iex-cli.ts",
    "test:ml": "python -m unittest ml.phase28.test_train",
    "test:ml-inference": "python -m unittest ml.phase31.test_infer"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.16.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "better-sqlite3": "12.4.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
