{
  "name": "trading-poc-001-bollinger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "POC educativo para detectar compresiones/expansiones de Bollinger en velas OHLCV y evaluar movimientos posteriores sin usar datos futuros para la senal.",
  "scripts": {
    "demo": "node --experimental-strip-types src/demo.ts && node --experimental-strip-types src/main.ts data/QQQ_FICTICIO_5min.csv",
    "analyze": "node --experimental-strip-types src/main.ts",
    "import:alpaca": "node --env-file-if-exists=.env --experimental-strip-types src/import-alpaca.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --experimental-strip-types --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "trading-signals": "8.3.0",
    "typescript": "5.9.3"
  }
}
