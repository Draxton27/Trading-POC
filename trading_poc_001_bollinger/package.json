{
  "name": "trading-poc-001-bollinger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "POC educativo para detectar compresiones/expansiones de Bollinger en velas OHLCV y evaluar movimientos posteriores sin usar datos futuros para la senal.",
  "scripts": {
    "demo": "node --experimental-strip-types src/demo.ts && node --experimental-strip-types src/main.ts data/QQQ_FICTICIO_5min.csv",
    "analyze": "node --experimental-strip-types src/main.ts",
    "import:alpaca": "node --env-file-if-exists=.env --experimental-strip-types src/import-alpaca.ts",
    "import:nvda": "node --env-file-if-exists=.env --experimental-strip-types src/import-nvda.ts",
    "import:nvda-history": "node --experimental-strip-types src/import-nvda-history.ts",
    "import:phase14-market": "node --experimental-strip-types src/import-phase14-market.ts",
    "compare:nvda-history": "node --experimental-strip-types src/compare-nvda-history.ts",
    "validate:nvda": "node --experimental-strip-types src/validate-nvda-opening.ts",
    "validate:nvda-volume": "node --experimental-strip-types src/validate-nvda-opening-volume.ts",
    "validate:nvda-indicators": "node --experimental-strip-types src/validate-nvda-indicators.ts",
    "validate:nvda-sma-context": "node --experimental-strip-types src/validate-nvda-sma-context.ts",
    "validate:nvda-pullback-breakout": "node --experimental-strip-types src/validate-nvda-pullback-breakout.ts",
    "validate:nvda-failed-breakouts": "node --experimental-strip-types src/validate-nvda-failed-breakouts.ts",
    "validate:nvda-volatility": "node --experimental-strip-types src/validate-nvda-volatility.ts",
    "validate:phase14-context": "node --experimental-strip-types src/validate-phase14-context.ts",
    "validate:phase15-confirmation": "node --experimental-strip-types src/validate-phase15-confirmation.ts",
    "validate:strategy": "node --experimental-strip-types src/validate-strategy.ts",
    "validate:ema9": "node --experimental-strip-types src/validate-ema9.ts",
    "validate:volume": "node --experimental-strip-types src/validate-volume.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --experimental-strip-types --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "trading-signals": "8.3.0",
    "typescript": "5.9.3"
  }
}
