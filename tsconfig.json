{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "jsx": "react-jsx", "esModuleInterop": true,
    "types": ["node", "vitest/globals"]
