# Copy this file to .env.local. It is ignored by Git.
TRADING_POC_MODE=PAPER
TRADING_POC_AGENT_MODE=TWS
# Leave TRADING_POC_AGENT_SECRET unset: npm run dev:paper creates and persists it securely.
TRADING_POC_API_HOST=127.0.0.1
TRADING_POC_API_PORT=4300
TRADING_POC_WEB_PORT=5173
TRADING_POC_AGENT_HOST=127.0.0.1
TRADING_POC_AGENT_PORT=4301
TRADING_POC_BACKEND_AGENT_URL=ws://127.0.0.1:4301/agent/v1/connect
IBKR_EXPECTED_PAPER_ACCOUNT=DU123456
IBKR_TWS_HOST=127.0.0.1
IBKR_TWS_PORT=7497
IBKR_CLIENT_ID=119
TRADING_POC_OLLAMA_MODEL=llama3.2:3b
TRADING_POC_OLLAMA_KEEP_ALIVE=5m
TRADING_POC_OLLAMA_TIMEOUT_MS=20000
# Noticias Fase 36. Sin una ruta explícita, API y CLI usan
# %LOCALAPPDATA%\Trading-POC\news en Windows, o private/news fuera de Windows.
# TRADING_POC_PRIVATE_DIR cambia el directorio privado base para ambos procesos.
# TRADING_POC_NEWS_DIR=C:\Trading-POC-private\news
# TRADING_POC_NEWS_OLLAMA_MODEL=llama3.2:3b
# El RSS de NVIDIA solo admite uso personal no comercial según sus condiciones.
# TRADING_POC_NEWS_NVIDIA_NONCOMMERCIAL=1
# Ruta absoluta a un run XGBoost local de Fases 28/29, si se desea mostrar el panel.
# TRADING_POC_ML_RUN_DIR=C:\ruta\privada\phase28-xgboost\20261020T134917Z-d22ccbc44e1e
# Alpaca SIP Phase 32 ingestion. Keep real values only in .env.local (ignored by Git).
# APCA_API_KEY_ID=replace-me
# APCA_API_SECRET_KEY=replace-me
# IEX Live usa estas mismas credenciales, pero un proceso y ledger independientes.
# TRADING_POC_IEX_LEDGER=C:\Trading-POC-private\iex\ledger.jsonl
# TRADING_POC_IEX_CALENDAR=C:\Trading-POC-private\iex\calendar.json
# Fase 38G: la tarea diaria reutiliza el modelo IEX congelado y el observador Fase 38F.
# TRADING_POC_IEX_FROZEN_DIR=C:\Trading-POC-private\ml-iex\frozen-run
# TRADING_POC_IEX_WARMUP_REGISTRY=C:\Trading-POC-private\ml-iex\warmup.json
# Registro REST 41P independiente; solo para decisiones futuras de la cohorte 41O_V2.
# TRADING_POC_IEX_OPPORTUNITY_CONTEXT_REGISTRY=C:\Trading-POC-private\iex\phase41p-context-v1.json
# TRADING_POC_IEX_OBSERVATION_LEDGER=C:\Trading-POC-private\ml-iex\observations.jsonl
# TRADING_POC_IEX_AUTOMATION_STATUS=C:\Trading-POC-private\ml-iex\daily-status.json
# Optional private JSONL destination. Default: private/alpaca-ingestion/ledger.jsonl
# TRADING_POC_ALPACA_INGESTION_LOG=C:\\Trading-POC-private\\alpaca-ingestion\\ledger.jsonl
# Optional private calendar and forward-observation ledger. They remain local.
# TRADING_POC_ALPACA_INGESTION_CALENDAR=C:\\Trading-POC-private\\alpaca-ingestion\\ledger.jsonl.calendar.json
# TRADING_POC_ML_FORWARD_OBSERVATION_LOG=C:\\Trading-POC-private\\ml-forward-observation\\records.jsonl
# Optional private collector status; default private/ml-collector/status.json
# TRADING_POC_ML_COLLECTOR_STATUS=C:\\Trading-POC-private\\ml-collector\\status.json
# TRADING_POC_ML_EVALUATION_LOG=C:\\Trading-POC-private\\ml-evaluation\\records.jsonl
# TRADING_POC_ML_EVALUATION_STATUS=C:\\Trading-POC-private\\ml-evaluation\\status.json
# Python 3.12 virtual environment used by ml:observe and ml:collect on Windows
# PYTHON=C:\\ruta\\Trading-POC\\.venv\\phase28-py312\\Scripts\\python.exe
